# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# MongoDB connection string.
# Transactions need a replica set (MongoDB Atlas works out of the box).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/digital-wallet?retryWrites=true&w=majority

# Any long random string, used to sign the JWT access tokens.
JWT_SECRET=replace_with_a_long_random_string

# SMTP account used to send the verification OTP emails.
# The app connects with secure: true, so use a TLS port such as 465.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password

# Optional, defaults to 3000.
PORT=3000
